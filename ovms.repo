# STRAWMAN ONLY: replace both example.invalid URLs with the official binary
# and matching source repositories. Confirm the product signing key as well.
# This is a lock-generation input, NOT a repository installed into the image.
[ovms-rhel9-rpms]
name=OVMS RHEL 9 x86_64 binaries - PLACEHOLDER
baseurl=https://example.invalid/REPLACE-ME/ovms/rhel9/$basearch/os/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release

[ovms-rhel9-source-rpms]
name=OVMS RHEL 9 source packages - PLACEHOLDER
baseurl=https://example.invalid/REPLACE-ME/ovms/rhel9/source/SRPMS/
enabled=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
