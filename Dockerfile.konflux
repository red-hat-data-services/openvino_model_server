# AIPCC cpu-el9.8:3.6.0 application image, not the corresponding -source artifact.
FROM quay.io/aipcc/base-images/cpu-el9.8@sha256:2a255b178a6b40d9e73ebb5ad199c22c3302bee6980ded45732031e215c7cbe7

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
USER 0

# Konflux mounts Hermeto output here; no live repository or RPM archives are
# copied into an image layer. The lockfile bind also invalidates the build cache
# when the selected package closure changes.
# Versions of unversioned requests are fixed by rpms.lock.yaml.
# hadolint ignore=DL3041
RUN --mount=type=bind,source=rpms.lock.yaml,target=/tmp/ovms-rpms.lock.yaml,ro \
    test -d /cachi2/output/deps/rpm/x86_64/repos.d && \
    dnf -y --noplugins \
        --setopt=reposdir=/cachi2/output/deps/rpm/x86_64/repos.d \
        --setopt=install_weak_deps=False \
        --setopt=keepcache=False \
        install \
        openvino_model_server-2026.4.0-1.el9 \
        openvino-2026.4.0-14.el9 \
        openvino-genai-2026.4.0.0-1.el9 \
        openvino_tokenizers-2026.4.0.0-1.el9 \
        ovms-abseil-cpp \
        ovms-azure-sdk-for-cpp \
        ovms-google-crc32c \
        ovms-libgguf \
        ovms-onnx-libs \
        ovms-opencv \
        ovms-protobuf \
        ovms-protobuf-lite \
        ovms-pugixml \
        ovms-tbb-2022.3.0-4.el9ai \
        ovms-xgrammar && \
    dnf --noplugins \
        --setopt=reposdir=/cachi2/output/deps/rpm/x86_64/repos.d clean all

# Resolve/download wheels before building. This instruction cannot use PyPI,
# build an sdist, or silently resolve an unpinned transitive dependency.
RUN --mount=type=bind,source=requirements.txt,target=/tmp/ovms-requirements.txt,ro \
    test -d /cachi2/output/deps/pip && \
    python3.12 -m pip install --no-cache-dir --no-index \
        --find-links=/cachi2/output/deps/pip \
        --only-binary=:all: --require-hashes -r /tmp/ovms-requirements.txt

RUN groupadd --gid 5000 ovms && \
    groupadd --gid 44 video1 && \
    useradd \
        --home-dir /home/ovms \
        --create-home \
        --uid 5000 \
        --gid 5000 \
        --groups 39,44 \
        --shell /bin/bash \
        --skel /dev/null \
        ovms

ENV HOME=/home/ovms
ENV PATH=/home/ovms/.local/bin:${PATH}
WORKDIR /
EXPOSE 8000 9000
USER ovms

# Final sanity check
RUN test "$(id -u)" -eq 5000 && \
    test "$(id -g)" -eq 5000 && \
    test -z "${LD_LIBRARY_PATH+x}" && \
    test -z "${PYTHONPATH+x}" && \
    test "$(python3.12 -c 'import sys; print(sys.prefix)')" = "/opt/app-root" && \
    python3.12 -c 'import pyovms; print(pyovms.__file__)' && \
    python3.12 -m pip --version && \
    python3.12 -m pip check && \
    /usr/bin/ovms --version

ENTRYPOINT ["/ovms/bin/ovms"]

LABEL name="rhoai/odh-openvino-model-server-rhel9" \
      com.redhat.component="odh-openvino-model-server-rhel9" \
      io.k8s.display-name="odh-openvino-model-server-rhel9" \
      io.k8s.description="OpenVINO Model Server (OVMS) is a high-performance system for serving models." \
      description="OpenVINO Model Server (OVMS) is a high-performance system for serving models." \
      summary="OpenVINO Model Server (OVMS) is a high-performance system for serving models." \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf" \
          vendor="Red Hat, Inc."
